# Copy to .env and replace all three values with independent random 64-character hex strings.
POSTGRES_PASSWORD=replace_with_random_secret
SETUP_BOOTSTRAP_TOKEN=replace_with_random_secret
SETUP_PLATFORM_BOOTSTRAP_TOKEN=replace_with_random_secret

# Optional destination for new support tickets and customer replies.
SUPPORT_EMAIL=

# Optional SMTP delivery for support tickets and other account notifications.
# Keep real values in the ignored local .env file; never commit SMTP credentials.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_ENABLE_SSL=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EnvanterTR
EMAIL_PUBLIC_BASE_URL=http://localhost:8080
PLATFORM_CRM_FOLLOW_UP_EMAIL_REMINDERS_ENABLED=false

# Optional iyzico Checkout Form credentials. Keep real values in ignored .env.
# Online checkout remains disabled until a public HTTPS callback is configured.
IYZIPAY_API_KEY=
IYZIPAY_SECRET_KEY=
IYZIPAY_BASE_URL=https://sandbox-api.iyzipay.com
IYZIPAY_CALLBACK_URL=

# Optional host port for the local-only preview.
APP_PORT=8080
