COPY src/EnvanterTR.PublicSite/checkout.html src/EnvanterTR.PublicSite/checkout.js /checkout-site/
COPY src/EnvanterTR.PublicSite/index.html /public-site/index.html
COPY src/EnvanterTR.Web/wwwroot/index.html /checkout-site/company-app.html
COPY src/EnvanterTR.Web/wwwroot/platform-admin.html /platform-site/platform-admin.html
