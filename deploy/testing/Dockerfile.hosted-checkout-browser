WORKDIR /acceptance
COPY deploy/testing/hosted-checkout-browser/package.json deploy/testing/hosted-checkout-browser/package-lock.json ./
RUN npm ci --omit=dev
COPY deploy/testing/hosted-checkout-browser/hosted-checkout.mjs ./
COPY deploy/testing/hosted-checkout-browser/command-palette.mjs ./
COPY deploy/testing/hosted-checkout-browser/asset-detail-actions.mjs ./
