# Generated by install.sh. Keep this file readable by root only.
APP_DOMAIN=inventory.example.com
POSTGRES_PASSWORD=replace-with-random-secret
SETUP_BOOTSTRAP_TOKEN=replace-with-random-secret
SETUP_PLATFORM_BOOTSTRAP_TOKEN=replace-with-random-secret
RELEASE_TAG=initial
# Optional SMTP for account recovery and company invitations. Configure in the root-only server.env.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_ENABLE_SSL=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=EnvanterTR
EMAIL_PUBLIC_BASE_URL=https://inventory.example.com
DATABASE_VOLUME_NAME=envantertr_server_database
COMPANY_MEDIA_VOLUME_NAME=envantertr_server_company_media
DATA_PROTECTION_KEYS_VOLUME_NAME=envantertr_server_data_protection_keys
BACKUP_ROOT=/var/backups/envantertr
BACKUP_PASSPHRASE_FILE=/etc/envantertr/backup.pass
BACKUP_RETENTION_DAYS=30
# Optional: all four SFTP settings must be configured together. The remote directory must already exist.
BACKUP_SFTP_TARGET=
BACKUP_SFTP_DIRECTORY=
BACKUP_SFTP_KEY_FILE=
BACKUP_SFTP_KNOWN_HOSTS_FILE=
BACKUP_SFTP_RETENTION_DAYS=90
